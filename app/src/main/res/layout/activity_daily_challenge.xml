<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pp_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pp_screen_padding">

        <!-- Top Bar -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/pp_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Daily Challenge"
                android:textColor="@color/pp_white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>

        <!-- Trophy -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="🏆"
            android:textSize="55sp" />

        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="DAILY CHALLENGE"
            android:textColor="@color/pp_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Today's Challenge"
            android:textColor="@color/pp_text_secondary"
            android:textSize="14sp" />

        <!-- Challenge Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/pp_card"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Category Label -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CATEGORY"
                android:textColor="@color/pp_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Category -->

            <TextView
                android:id="@+id/categoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="General Knowledge"
                android:textColor="@color/pp_white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Level -->

            <TextView
                android:id="@+id/levelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Level 1 • 10 Questions"
                android:textColor="@color/pp_text_secondary"
                android:textSize="15sp" />

            <!-- Status -->

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="🎯 Complete today's challenge!"
                android:textColor="@color/pp_white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Start Button -->

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/pp_button_primary"
            android:text="START CHALLENGE"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Information -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="A new challenge will be available tomorrow."
            android:textColor="@color/pp_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:text="🌐 No internet required"
            android:textColor="@color/pp_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>