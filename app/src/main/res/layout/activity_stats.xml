<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pp_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📊 My Progress"
                android:textColor="@color/pp_white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>


        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Track your Prime Puzzles journey"
            android:textColor="@color/pp_text_secondary"
            android:textSize="15sp" />


        <!-- Statistics Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/pp_card"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Total Quizzes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📝 Total Quizzes"
                    android:textColor="@color/pp_white"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/totalQuizzesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/pp_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Best Score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏆 Best Score"
                    android:textColor="@color/pp_white"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/bestScoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/pp_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Completed Levels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎯 Completed Levels"
                    android:textColor="@color/pp_white"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/completedLevelsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 6"
                    android:textColor="@color/pp_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- Category Progress Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="CATEGORY PROGRESS"
            android:textColor="@color/pp_white"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- UPSC -->
        <!-- UPSC Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/pp_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Category Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🇮🇳 UPSC"
                    android:textColor="@color/pp_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upscPercentageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/pp_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Level Progress -->
            <TextView
                android:id="@+id/upscProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 / 6 levels completed"
                android:textColor="@color/pp_text_secondary"
                android:textSize="14sp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/upscProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="6"
                android:progress="0" />

            <!-- Current Level -->
            <TextView
                android:id="@+id/upscCurrentLevelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔓 Current Level: 1"
                android:textColor="@color/pp_white"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- MPSC -->
        <!-- MPSC Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/pp_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Category Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏛️ MPSC"
                    android:textColor="@color/pp_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mpscPercentageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/pp_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Level Progress -->
            <TextView
                android:id="@+id/mpscProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 / 6 levels completed"
                android:textColor="@color/pp_text_secondary"
                android:textSize="14sp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/mpscProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="6"
                android:progress="0" />

            <!-- Current Level -->
            <TextView
                android:id="@+id/mpscCurrentLevelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔓 Current Level: 1"
                android:textColor="@color/pp_white"
                android:textSize="14sp" />

        </LinearLayout>


    </LinearLayout>

</ScrollView>